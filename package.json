{
  "name": "vampire-hunters",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "desktop": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "vite": "^5.4.21",
    "phaser": "^3.90.0"
  },
  "productName": "Vampire Hunters",
  "description": "Vampire Hunters \u2014 an original JRPG.",
  "author": "Vampire Hunters",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.vampirehunters.game",
    "productName": "Vampire Hunters",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vampire Hunters",
      "artifactName": "VampireHunters-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VampireHunters-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png"
    }
  }
}