{
  "name": "eidra-nexus-academy",
  "productName": "Eidra Nexus Academy",
  "version": "0.1.0",
  "private": true,
  "description": "EIDRA: NEXUS ACADEMY - a creature-collecting card RPG.",
  "author": "Eidra Team",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite build && electron-forge start",
    "test": "node test/engine.test.mjs && node test/puzzles.test.mjs && node test/sim.test.mjs",
    "playtest": "vite build && node tools/playtest.mjs",
    "check:electron": "vite build && node tools/electron-check.mjs",
    "art": "python3 tools/gen_art.py",
    "package:win": "vite build && electron-forge package --platform=win32 --arch=x64",
    "make:win": "vite build && electron-forge make --platform=win32 --arch=x64",
    "make:win-zip": "vite build && electron-forge make --platform=win32 --arch=x64 --targets=@electron-forge/maker-zip",
    "make:linux": "vite build && electron-forge make --platform=linux --arch=x64 --targets=@electron-forge/maker-zip"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "electron": "^44.5.1",
    "playwright-core": "^1.55.0",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0"
  }
}
